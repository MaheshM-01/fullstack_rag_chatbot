

# ============================================================
# RAG CHATBOT - Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file: copy .env.example .env
#   2. Fill in YOUR real values in .env
#   3. Never share or push .env to GitHub
# ============================================================


# ============================================================
# GROQ API (Free LLM)
# ============================================================
# WHAT: Groq gives you free access to Llama3, Mixtral models
# WHY:  We use this instead of OpenAI — 100% free tier
# WHERE TO GET: https://console.groq.com → API Keys → Create
#
# Free tier limits:
#   - 30 requests/minute
#   - 14,400 requests/day
#   - Completely free — no credit card needed
# ============================================================
GROQ_API_KEY=your-groq-api-key-here

# Which Groq model to use
# Options:
#   llama3-8b-8192      → Fast, good for simple Q&A
#   llama3-70b-8192     → Smarter, better answers (recommended)
#   mixtral-8x7b-32768  → Biggest context window (32k tokens)
GROQ_MODEL_NAME=llama3-70b-8192


# ============================================================
# CHROMADB (Local Vector Database)
# ============================================================
# WHAT: ChromaDB stores your document embeddings locally
#       as files on your computer (no cloud needed!)
# WHY:  Free, fast, works offline, perfect for portfolio projects
# WHERE: Creates a folder called 'chroma_db' in your project
#        rag-chatbot/
#           └── chroma_db/    ← ChromaDB saves data here
#               ├── chroma.sqlite3
#               └── collections/
# ============================================================
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents


# ============================================================
# EMBEDDINGS MODEL (Local — 100% Free)
# ============================================================
# WHAT: Converts text → numbers (vectors) for semantic search
# WHY:  sentence-transformers runs on YOUR machine — no API needed
# HOW:  First run downloads the model (~90MB), then it's cached
#
# Options (all free):
#   all-MiniLM-L6-v2          → Fast, small (90MB) ← we use this
#   all-mpnet-base-v2          → More accurate, larger (420MB)
#   paraphrase-multilingual    → Supports Tamil/Hindi too!
# ============================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2


# ============================================================
# FASTAPI WORKER SERVER
# ============================================================
# WHAT: Python RAG engine runs as a local server on port 8000
# WHY:  NestJS backend talks to this Python server via HTTP
# ============================================================
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_RELOAD=true


# ============================================================
# NESTJS API SERVER
# ============================================================
# WHAT: Main backend server — handles auth, chat, users
# WHY:  Frontend talks to NestJS, NestJS talks to Python worker
# ============================================================
API_PORT=3001
API_HOST=localhost

# JWT Secret — for user authentication tokens
# IMPORTANT: Change this to a random 32+ character string
# Generate one: https://generate-secret.vercel.app/32
JWT_SECRET=change-this-to-a-random-32-char-string-minimum
JWT_EXPIRES_IN=7d


# ============================================================
# DATABASE (PostgreSQL — for chat history, users)
# ============================================================
# WHAT: Stores user accounts, chat sessions, message history
# WHY:  ChromaDB stores vectors, PostgreSQL stores everything else
# HOW TO INSTALL LOCAL:
#   Windows: https://www.postgresql.org/download/windows/
#   Or use Docker: docker run -p 5432:5432 -e POSTGRES_PASSWORD=password postgres
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/ragchatbot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragchatbot
DB_USER=postgres
DB_PASSWORD=password


# ============================================================
# REDIS (for caching — optional for now)
# ============================================================
# WHAT: Caches frequent questions so we don't hit Groq every time
# WHY:  Groq has rate limits (30 req/min) — cache saves quota
# NOTE: Skip this for now, add later when needed
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false


# ============================================================
# FILE UPLOAD SETTINGS
# ============================================================
# WHAT: Where uploaded PDFs/docs are temporarily stored
# WHY:  Before ingestion, files need a temp location
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,txt,docx


# ============================================================
# APP SETTINGS
# ============================================================
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL (for CORS — which domains can talk to our API)
FRONTEND_URL=http://localhost:3000


# ============================================================
# RAG SETTINGS
# ============================================================
# WHAT: Controls how RAG retrieval works
# WHY:  Tuning these affects answer quality

# How many chunks to retrieve per question
# More chunks = more context = better answers (but slower)
RAG_TOP_K=5

# Minimum similarity score (0.0 to 1.0)
# Higher = more strict matching
# 0.7 = only return chunks that are 70%+ similar to question
RAG_SCORE_THRESHOLD=0.7

# Chunk size in characters
# 500 chars ≈ 100 words ≈ one paragraph
RAG_CHUNK_SIZE=500

# Overlap between chunks (prevents cutting sentences mid-thought)
RAG_CHUNK_OVERLAP=50